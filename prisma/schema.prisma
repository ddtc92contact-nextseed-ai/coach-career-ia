// Schéma de données coach-career-ia.
//
// Règle de confidentialité : les champs identifiants (nom, coordonnées,
// employeur…) vivent dans des modèles d'identité dédiés, séparés du profil
// partageable. Ici, seul `User` (et les tables techniques d'Auth.js) porte une
// donnée identifiante : l'adresse e-mail de connexion. Toute table métier
// doit référencer `User.id` (suppression en cascade) et chaque requête doit
// être filtrée par l'utilisateur courant (voir `requireUser()`).
//
// La mémoire de carrière (expériences, réalisations, preuves, compétences,
// garde-fous) est un profil PSEUDONYMISÉ : aucun nom d'employeur, nom de
// personne ni coordonnée n'y a de champ. L'employeur est décrit de façon
// générique (secteur, taille, stade). Les seules valeurs identifiantes
// possibles — noms d'entreprises exclues, noms de fichiers des justificatifs —
// sont chiffrées au niveau applicatif (`src/lib/crypto`).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Compte d'identité. Donnée personnelle : `email`. Ne jamais l'exposer
/// dans un profil anonymisé ni dans les logs.
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  /// Langue préférée (`fr`, `en`…) : e-mails et textes générés par l'IA.
  /// `null` tant que l'utilisateur n'a rien choisi (langue de navigation).
  locale        String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  /// Offre freemium. Recalculée par le webhook Stripe à partir de l'état de
  /// l'abonnement chez Stripe — jamais d'après une donnée du navigateur.
  /// Lire les droits via `getEntitlements()` (`src/lib/billing`), jamais ici.
  plan                 Plan                @default(FREE)
  subscriptionStatus   SubscriptionStatus? @map("subscription_status")
  /// Fin de la période payée en cours (renouvellement ou fin d'accès).
  currentPeriodEnd     DateTime?           @map("current_period_end")
  cancelAtPeriodEnd    Boolean             @default(false) @map("cancel_at_period_end")
  stripeCustomerId     String?             @unique @map("stripe_customer_id")
  stripeSubscriptionId String?             @unique @map("stripe_subscription_id")

  /// Version des conditions d'utilisation et de la politique de confidentialité
  /// acceptées (`LEGAL_TERMS_VERSION`, `src/config/legal.ts`) et date de
  /// l'acceptation, enregistrées à la connexion qui suit leur affichage.
  termsVersion    String?   @map("terms_version")
  termsAcceptedAt DateTime? @map("terms_accepted_at")

  accounts     Account[]
  sessions     Session[]
  profile      CareerProfile?
  experiences  Experience[]
  achievements Achievement[]
  proofs       Proof[]
  skills       Skill[]
  guardRails   GuardRails?
  locations    GuardRailLocation[]
  vault        IdentityVault?
  matches      Match[]
  matching     MatchingState?
  embeddings   MemoryEmbedding[]

  coachConversations CoachConversation[]
  coachMessages      CoachMessage[]
  coachSuggestions   CoachSuggestion[]

  simulatedSubscriptions SimulatedSubscription[]

  profileCard    ProfileCard?
  cardLinks      CardLink[]
  contacts       Contact[]
  contactReplies ContactReply[]
  handovers      Handover[]
  handoverEvents HandoverEvent[]

  negotiationMandates NegotiationMandate[]
  negotiationMessages NegotiationMessage[]

  /// Espace entreprise : un compte peut être candidat, membre d'une organisation, ou les deux.
  organizationMemberships OrganizationMember[]
  jobPostingPayments      JobPostingPayment[]

  @@map("users")
}

/// Comptes de fournisseurs d'identité (Auth.js). Inutilisé tant que seule la
/// connexion par lien magique est proposée, mais requis par l'adaptateur.
model Account {
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// Sessions persistées en base : la déconnexion les révoque immédiatement.
model Session {
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Jetons de lien magique (stockés hachés par Auth.js).
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Mémoire de carrière (profil pseudonymisé)
// ---------------------------------------------------------------------------

enum VisibilityStatus {
  /// En recherche active : profil proposé en priorité.
  ACTIVE
  /// Ouvert aux opportunités.
  OPEN
  /// Invisible : aucun recruteur ne voit le profil.
  INVISIBLE
}

enum Seniority {
  INTERN
  JUNIOR
  MID
  SENIOR
  LEAD
  MANAGER
  DIRECTOR
  EXECUTIVE
}

enum CompanySize {
  S1_10
  S11_50
  S51_200
  S201_500
  S501_1000
  S1001_5000
  S5001_PLUS
}

enum CompanyStage {
  STARTUP
  SCALEUP
  SME
  MIDCAP
  LARGE_CORP
  PUBLIC_SECTOR
  NONPROFIT
  CONSULTANCY
}

/// Niveau de preuve d'une réalisation. `VERIFIED` est réservé à une
/// vérification par un tiers (fonctionnalité future).
enum EvidenceLevel {
  DECLARED
  DOCUMENT
  VERIFIED
}

enum ProofKind {
  URL
  DOCUMENT
  REFERENCE
}

/// Réglages du profil (1-1 avec l'utilisateur).
model CareerProfile {
  userId     String           @id @map("user_id")
  visibility VisibilityStatus @default(INVISIBLE)
  updatedAt  DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("career_profiles")
}

/// Expérience professionnelle. L'employeur n'est PAS nommé : seulement décrit.
model Experience {
  id               String       @id @default(cuid())
  userId           String       @map("user_id")
  roleTitle        String       @map("role_title")
  /// Premier jour du mois de début (précision : le mois).
  startMonth       DateTime     @map("start_month") @db.Date
  /// Premier jour du mois de fin ; `null` = poste actuel.
  endMonth         DateTime?    @map("end_month") @db.Date
  seniority        Seniority
  contractType     ContractType @map("contract_type")
  /// Code de secteur (`src/lib/career/codes.ts`), affiché via les traductions.
  sector           String
  companySize      CompanySize  @map("company_size")
  companyStage     CompanyStage @map("company_stage")
  responsibilities String       @default("")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievements Achievement[]

  @@index([userId])
  @@map("experiences")
}

/// Réalisation, cœur de la mémoire de carrière.
model Achievement {
  id            String        @id @default(cuid())
  userId        String        @map("user_id")
  experienceId  String?       @map("experience_id")
  title         String
  context       String        @default("")
  actions       String        @default("")
  result        String        @default("")
  /// Calculé : `DOCUMENT` dès qu'au moins une preuve est jointe.
  evidenceLevel EvidenceLevel @default(DECLARED) @map("evidence_level")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  experience Experience?        @relation(fields: [experienceId], references: [id], onDelete: SetNull)
  proofs     Proof[]
  skills     AchievementSkill[]

  @@index([userId])
  @@index([experienceId])
  @@map("achievements")
}

/// Preuve d'une réalisation : lien, document privé ou témoignage écrit.
model Proof {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  achievementId String    @map("achievement_id")
  kind          ProofKind
  /// `URL` : adresse publique de la preuve.
  url           String?
  /// `REFERENCE` : texte du témoignage (sans nom ni coordonnées).
  referenceText String?   @map("reference_text")
  /// `DOCUMENT` : clé de stockage du fichier chiffré (`src/lib/career/storage.ts`).
  storageKey    String?   @unique @map("storage_key")
  /// `DOCUMENT` : nom de fichier d'origine, chiffré (peut être identifiant).
  fileNameEnc   String?   @map("file_name_enc")
  mimeType      String?   @map("mime_type")
  sizeBytes     Int?      @map("size_bytes")
  createdAt     DateTime  @default(now()) @map("created_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([achievementId])
  @@map("proofs")
}

/// Compétence. Niveau et dernière utilisation sont calculés depuis les
/// réalisations qui l'utilisent ; sans réalisation, elle est « non prouvée ».
model Skill {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  /// Nom normalisé (minuscules, espaces réduits) : unicité par utilisateur.
  nameKey   String   @map("name_key")
  createdAt DateTime @default(now()) @map("created_at")

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievements AchievementSkill[]

  @@unique([userId, nameKey])
  @@map("skills")
}

model AchievementSkill {
  achievementId String @map("achievement_id")
  skillId       String @map("skill_id")

  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  skill       Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([achievementId, skillId])
  @@index([skillId])
  @@map("achievement_skills")
}

/// Garde-fous : filtres durs appliqués par le matching (1-1 avec l'utilisateur).
/// Montants en euros bruts annuels.
model GuardRails {
  userId             String         @id @map("user_id")
  minFixedSalary     Int?           @map("min_fixed_salary")
  targetTotalPackage Int?           @map("target_total_package")
  /// Enums partagés avec le radar ; l'application n'accepte que des valeurs
  /// explicites (jamais `UNKNOWN` ni `OTHER`, voir `src/lib/career/codes.ts`).
  remotePolicy       RemotePolicy?  @map("remote_policy")
  minRemoteDays      Int?           @map("min_remote_days")
  contractTypes      ContractType[] @map("contract_types")
  /// Codes de secteur exclus.
  excludedSectors    String[]       @map("excluded_sectors")
  /// Noms d'entreprises exclues, chacun chiffré (AAD `user:<id>:excluded-company`).
  excludedCompanies  String[]       @map("excluded_companies_enc")
  maxWeeklyHours     Int?           @map("max_weekly_hours")
  acceptsOnCall      Boolean        @default(false) @map("accepts_on_call")
  /// Codes de préférences de culture d'entreprise (facultatifs).
  culturePreferences String[]       @map("culture_preferences")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("guard_rails")
}

/// Zone de travail acceptée : une ville et un rayon. Les coordonnées sont
/// renseignées par géocodage à l'enregistrement (`src/lib/geo`) ; `null` si la
/// ville n'a pas pu être localisée (le lieu est tout de même conservé).
/// Donnée du candidat : ni le libellé ni les coordonnées ne sont journalisés.
model GuardRailLocation {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  label     String
  radiusKm  Int      @map("radius_km")
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("guard_rail_locations")
}

// ---------------------------------------------------------------------------
// Coach IA : conversations, messages et suggestions
//
// Le contenu des messages (texte libre du candidat, réponses du modèle) peut
// contenir des données identifiantes : il est chiffré au niveau applicatif
// (AAD `user:<id>:coach-message`). Les suggestions sont des BROUILLONS
// pseudonymisés : rien n'est écrit dans la mémoire de carrière tant que le
// candidat ne les a pas acceptées.
// ---------------------------------------------------------------------------

/// Compétence (« skill ») du coach choisie au début d'une conversation.
enum CoachMode {
  /// Découvrir mon profil : entretien STAR → réalisations prouvées.
  DISCOVER
  /// Clarifier ce que je veux : salaire, lieu, télétravail… → garde-fous.
  CLARIFY
  /// Préparer un entretien : simulation et retours.
  INTERVIEW
}

enum CoachRole {
  USER
  ASSISTANT
}

enum CoachSuggestionKind {
  ACHIEVEMENT
  EXPERIENCE_UPDATE
  SKILL
  GUARD_RAIL
}

enum CoachSuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model CoachConversation {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  mode          CoachMode
  /// Tour en cours (verrou) : un seul appel au modèle à la fois par conversation.
  /// Un verrou plus ancien que le budget d'un tour est considéré comme abandonné.
  turnStartedAt DateTime? @map("turn_started_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    CoachMessage[]
  suggestions CoachSuggestion[]

  @@index([userId, updatedAt])
  @@map("coach_conversations")
}

model CoachMessage {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  conversationId String    @map("conversation_id")
  role           CoachRole
  /// Texte chiffré (AAD `user:<id>:coach-message`).
  contentEnc     String    @map("content_enc")
  /// Message du candidat : nombre de relances après une panne (plafonné).
  retryCount     Int       @default(0) @map("retry_count")
  createdAt      DateTime  @default(now()) @map("created_at")

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation CoachConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  suggestions  CoachSuggestion[]

  @@index([conversationId, createdAt])
  /// Quota quotidien : messages envoyés par l'utilisateur.
  @@index([userId, role, createdAt])
  @@map("coach_messages")
}

/// Suggestion du coach, affichée comme une carte que le candidat accepte,
/// modifie ou rejette. `payload` : contenu pseudonymisé, validé par zod
/// (`src/lib/coach/suggestions.ts`) avant tout enregistrement.
model CoachSuggestion {
  id              String                @id @default(cuid())
  userId          String                @map("user_id")
  conversationId  String                @map("conversation_id")
  /// Réponse du coach qui porte la suggestion.
  messageId       String?               @map("message_id")
  kind            CoachSuggestionKind
  status          CoachSuggestionStatus @default(PENDING)
  payload         Json
  /// Un nom, un contact ou un employeur a été retiré du texte proposé.
  identityRemoved Boolean               @default(false) @map("identity_removed")
  createdAt       DateTime              @default(now()) @map("created_at")
  decidedAt       DateTime?             @map("decided_at")

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation CoachConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      CoachMessage?     @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([conversationId])
  @@index([messageId])
  @@map("coach_suggestions")
}

// ---------------------------------------------------------------------------
// Coffre d'identité « zéro connaissance »
// ---------------------------------------------------------------------------

/// Identité réelle du candidat (nom, coordonnées, employeurs, écoles, liens,
/// CV d'origine), chiffrée DANS LE NAVIGATEUR (`src/lib/vault/crypto.ts`).
/// Le serveur ne stocke que des enveloppes opaques : il ne peut rien en lire
/// (ni phrase secrète, ni clé de secours, ni clé de données en clair).
model IdentityVault {
  userId               String   @id @map("user_id")
  /// Version du format cryptographique.
  version              Int
  /// Paramètres de dérivation de la phrase secrète (`PBKDF2-SHA256`).
  kdfName              String   @map("kdf_name")
  kdfIterations        Int      @map("kdf_iterations")
  kdfSalt              Bytes    @map("kdf_salt")
  /// Clé de données enveloppée par la phrase secrète, puis par la clé de secours.
  passphraseWrappedKey Bytes    @map("passphrase_wrapped_key")
  recoveryWrappedKey   Bytes    @map("recovery_wrapped_key")
  /// Identité chiffrée (JSON complété à 256 octets).
  identityCiphertext   Bytes?   @map("identity_ciphertext")
  /// CV d'origine chiffré (nom et type de fichier compris).
  cvCiphertext         Bytes?   @map("cv_ciphertext")
  /// Incrémenté à chaque écriture : évite d'écraser une version plus récente.
  revision             Int      @default(0)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("identity_vaults")
}

// ---------------------------------------------------------------------------
// Abonnements (freemium candidat). Stripe ne reçoit que l'e-mail de connexion
// et l'identifiant du compte ; aucune donnée de carte ne transite par nos
// serveurs. La facturation côté entreprise (phase 2) aura ses propres
// modèles, rattachés à l'entreprise et non au candidat.
// ---------------------------------------------------------------------------

enum Plan {
  FREE
  PREMIUM
}

/// Statuts d'abonnement Stripe (`subscription.status`).
enum SubscriptionStatus {
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  PAUSED
}

/// Évènements Stripe déjà traités : un évènement rejoué est ignoré.
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("stripe_events")
}

/// Abonnements du simulateur de paiement (`BILLING_PROVIDER=simulator`, phase
/// de test) : l'état que Stripe tiendrait de son côté. Le simulateur émet les
/// mêmes évènements que Stripe vers le même traitement que le webhook, qui
/// relit cette table comme il relirait Stripe. Identifiants préfixés `sim_`.
/// Aucune donnée personnelle ni bancaire.
model SimulatedSubscription {
  /// `sim_sub_…` (= `users.stripe_subscription_id` une fois payé).
  id                String             @id
  userId            String             @map("user_id")
  /// `sim_cus_…` (= `users.stripe_customer_id`).
  customerId        String             @map("customer_id")
  /// `sim_cs_…` : session de paiement simulée (URL de la page de paiement).
  checkoutSessionId String             @unique @map("checkout_session_id")
  /// `INCOMPLETE` tant que le paiement simulé n'est pas validé.
  status            SubscriptionStatus @default(INCOMPLETE)
  cancelAtPeriodEnd Boolean            @default(false) @map("cancel_at_period_end")
  currentPeriodEnd  DateTime?          @map("current_period_end")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("simulated_subscriptions")
}

// ---------------------------------------------------------------------------
// Market Radar : offres d'emploi collectées auprès de sources autorisées
// (API France Travail, endpoints publics des job boards ATS). Données
// publiques, non rattachées à un utilisateur. Des contacts recruteurs fournis
// par certaines sources, seul le canal de CANDIDATURE publié est conservé
// (e-mail de candidature, URL « Postuler ») : jamais de nom ni de téléphone.
// ---------------------------------------------------------------------------

enum AtsType {
  GREENHOUSE
  LEVER
  ASHBY
  SMARTRECRUITERS
  RECRUITEE
  WORKABLE
}

enum RemotePolicy {
  ONSITE
  HYBRID
  FULL_REMOTE
  UNKNOWN
}

enum ContractType {
  CDI
  CDD
  FREELANCE
  INTERNSHIP
  APPRENTICESHIP
  TEMPORARY
  OTHER
  UNKNOWN
}

enum SalaryPeriod {
  HOUR
  DAY
  MONTH
  YEAR
}

enum OfferStatus {
  OPEN
  CLOSED
  /// Offre publiée directement par une entreprise, pas encore en ligne
  /// (brouillon, paiement ou modération en attente). Jamais lue par le matching.
  DRAFT
}

enum SourceRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

/// Entreprise suivie par le radar (job board ATS public).
model Company {
  id         String   @id @default(cuid())
  /// Identifiant stable issu de la configuration (`config/radar-companies.json`).
  slug       String   @unique
  name       String
  website    String?
  sector     String?
  atsType    AtsType? @map("ats_type")
  boardToken String?  @map("board_token")
  /// Région de l'API (ex. Lever « eu »), si l'ATS en distingue plusieurs.
  atsRegion  String?  @map("ats_region")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  offers       JobOffer[]
  weekStats    CompanyWeekStat[]
  signals      CompanySignal[]
  /// Organisation de l'espace entreprise qui publie sous ce nom (offres directes).
  organization Organization?

  @@unique([atsType, boardToken])
  @@map("companies")
}

/// Offre d'emploi normalisée. Le salaire reste `null` quand l'offre ne
/// l'indique pas : il n'est jamais estimé dans cette couche.
model JobOffer {
  id                 String        @id @default(cuid())
  /// Connecteur d'origine : france_travail, greenhouse, lever, ashby.
  source             String
  /// Périmètre d'une collecte complète (ex. `greenhouse:dataiku`) : sert à
  /// fermer les offres disparues.
  sourceKey          String        @map("source_key")
  sourceId           String        @map("source_id")
  url                String
  /// URL normalisée, pour la déduplication inter-sources.
  urlKey             String        @map("url_key")
  /// Entreprise + intitulé + lieu normalisés, pour la déduplication.
  dedupKey           String?       @map("dedup_key")
  title              String
  companyName        String?       @map("company_name")
  companyId          String?       @map("company_id")
  description        String        @db.Text
  city               String?
  region             String?
  /// Code pays ISO 3166-1 alpha-2 quand il est connu.
  country            String?
  /// Coordonnées de la ville (fournies par la source ou géocodées), `null` si
  /// inconnues. Servent au filtre de distance du matching.
  latitude           Float?
  longitude          Float?
  /// Date du dernier géocodage abouti (trouvé ou introuvable). `null` = à
  /// (re)tenter : nouvelle offre, lieu modifié ou géocodeur indisponible.
  geocodedAt         DateTime?     @map("geocoded_at")
  remotePolicy       RemotePolicy  @default(UNKNOWN) @map("remote_policy")
  contractType       ContractType  @default(UNKNOWN) @map("contract_type")
  /// Libellé de contrat tel que fourni par la source.
  contractLabel      String?       @map("contract_label")
  salaryMin          Decimal?      @map("salary_min") @db.Decimal(12, 2)
  salaryMax          Decimal?      @map("salary_max") @db.Decimal(12, 2)
  salaryCurrency     String?       @map("salary_currency")
  salaryPeriod       SalaryPeriod? @map("salary_period")
  /// Part variable (primes, bonus, commissions) telle qu'annoncée.
  salaryVariable     String?       @map("salary_variable")
  /// Equity / BSPCE tels qu'annoncés.
  salaryEquity       String?       @map("salary_equity")
  /// Texte de rémunération brut fourni par la source.
  salaryRaw          String?       @map("salary_raw")
  sector             String?
  seniority          String?
  publishedAt        DateTime?     @map("published_at")
  firstSeenAt        DateTime      @map("first_seen_at")
  lastSeenAt         DateTime      @map("last_seen_at")
  closedAt           DateTime?     @map("closed_at")
  /// Dernière réapparition après une fermeture (même offre republiée), et
  /// nombre de réapparitions : signal « offre difficile à pourvoir ».
  reopenedAt         DateTime?     @map("reopened_at")
  reopenCount        Int           @default(0) @map("reopen_count")
  status             OfferStatus   @default(OPEN)
  contentHash        String        @map("content_hash")
  /// Offre canonique dont celle-ci est un doublon (autre source).
  duplicateOfId      String?       @map("duplicate_of_id")
  /// Canal de candidature publié dans l'offre (`src/lib/radar/apply.ts`) :
  /// adresse e-mail de candidature et/ou URL « Postuler ». Jamais de nom ni de
  /// téléphone de recruteur.
  applyEmail         String?       @map("apply_email")
  /// L'adresse semble nominative : elle ne sert qu'à l'envoi, n'est jamais
  /// affichée ni journalisée.
  applyEmailPersonal Boolean       @default(false) @map("apply_email_personal")
  applyUrl           String?       @map("apply_url")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  company     Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  duplicateOf JobOffer?       @relation("OfferDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates  JobOffer[]      @relation("OfferDuplicates")
  matches     Match[]
  embedding   OfferEmbedding?
  contacts    Contact[]
  /// Offre publiée directement par une entreprise (`source = "direct"`).
  posting     JobPosting?

  @@unique([source, sourceId])
  @@index([sourceKey, status])
  @@index([urlKey])
  @@index([dedupKey])
  @@index([status, lastSeenAt])
  @@index([companyId])
  @@index([status, geocodedAt])
  @@map("job_offers")
}

/// Statistiques hebdomadaires de recrutement d'une entreprise, recalculées
/// à partir des offres collectées (doublons exclus). Semaine = lundi 00:00 UTC.
model CompanyWeekStat {
  id                String   @id @default(cuid())
  companyId         String   @map("company_id")
  weekStart         DateTime @map("week_start")
  newOffers         Int      @map("new_offers")
  closedOffers      Int      @map("closed_offers")
  /// Offres ouvertes à la fin de la semaine.
  openCount         Int      @map("open_count")
  /// Médiane (jours) entre première vue et fermeture des offres fermées dans la semaine.
  medianDaysToClose Float?   @map("median_days_to_close")
  /// Part des nouvelles offres annonçant un salaire (0–1), `null` sans nouvelle offre.
  salaryShare       Float?   @map("salary_share")
  /// Part des nouvelles offres hybrides ou en télétravail complet parmi celles qui le précisent.
  remoteShare       Float?   @map("remote_share")
  newCities         String[] @map("new_cities")
  newCountries      String[] @map("new_countries")
  /// Familles de métiers (codes `JobFamily`) jamais vues auparavant.
  newFamilies       String[] @map("new_families")
  /// Premier poste de management / direction de l'entreprise.
  firstLeadership   Boolean  @default(false) @map("first_leadership")
  computedAt        DateTime @map("computed_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, weekStart])
  @@map("company_week_stats")
}

enum CompanySignalType {
  HIRING_SURGE
  HIRING_FREEZE
  NEW_TEAM
  NEW_LOCATION
  REPOSTED_OFFER
  REMOTE_SHIFT
}

/// Signal faible détecté sur une entreprise pour une semaine. Les faits sont
/// structurés (nombres, codes, villes, intitulés d'offres) : aucune donnée
/// personnelle. Un seul signal par entreprise, type et semaine (idempotent).
model CompanySignal {
  id          String            @id @default(cuid())
  companyId   String            @map("company_id")
  type        CompanySignalType
  /// 1 (faible) à 3 (fort).
  strength    Int
  periodStart DateTime          @map("period_start")
  periodEnd   DateTime          @map("period_end")
  facts       Json
  detectedAt  DateTime          @map("detected_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, type, periodStart])
  @@index([periodStart])
  @@map("company_signals")
}

/// Cache persistant du géocodage : une même requête normalisée (ville, pays,
/// code commune) n'est jamais géocodée deux fois. Aucune donnée personnelle :
/// la clé ne désigne qu'un lieu, sans lien avec un utilisateur.
/// Niveau d'un repère de salaire, du plus précis au plus large.
enum SalaryBenchmarkScope {
  /// Famille × séniorité × pays × zone (région française ou télétravail complet).
  REGION
  /// Famille × séniorité × pays.
  COUNTRY
  /// Famille × pays, toutes séniorités.
  FAMILY_COUNTRY
}

/// Repère de salaire du marché, recalculé par le worker à partir des seules
/// fourchettes publiées dans les offres collectées (`src/lib/radar/benchmarks`).
/// Euros bruts annuels. Seuls les repères atteignant l'échantillon minimal
/// sont enregistrés.
model SalaryBenchmark {
  id          String               @id @default(cuid())
  /// `scope|famille|séniorité|pays|zone` : clé unique de recalcul.
  key         String               @unique
  scope       SalaryBenchmarkScope
  family      String
  /// Code de séniorité, ou `ALL` au niveau `FAMILY_COUNTRY`.
  seniority   String
  country     String
  /// Région française ou `REMOTE` au niveau `REGION`, sinon `null`.
  area        String?
  sampleSize  Int                  @map("sample_size")
  p25         Int
  median      Int
  p75         Int
  /// Dates de publication (ou de première collecte) des offres utilisées.
  periodStart DateTime             @map("period_start")
  periodEnd   DateTime             @map("period_end")
  computedAt  DateTime             @map("computed_at")

  @@index([family, country])
  @@map("salary_benchmarks")
}

model GeoCache {
  /// Requête normalisée (`src/lib/geo/geocoder.ts`, `geoCacheKey`).
  key       String   @id
  /// Faux = lieu introuvable (réessayé après expiration, voir `NOT_FOUND_TTL_MS`).
  found     Boolean
  latitude  Float?
  longitude Float?
  /// Code pays ISO 3166-1 alpha-2 du résultat.
  country   String?
  /// Précision : address, street, locality, municipality, region.
  precision String?
  /// Fournisseur qui a répondu (ban, nominatim).
  provider  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("geo_cache")
}

/// Journal d'exécution d'un connecteur (une ligne par périmètre et par passage).
model SourceRun {
  id             String          @id @default(cuid())
  source         String
  sourceKey      String          @map("source_key")
  status         SourceRunStatus @default(RUNNING)
  startedAt      DateTime        @map("started_at")
  finishedAt     DateTime?       @map("finished_at")
  /// Vrai si la collecte a couvert tout le périmètre (condition pour fermer
  /// les offres disparues).
  complete       Boolean         @default(false)
  fetchedCount   Int             @default(0) @map("fetched_count")
  createdCount   Int             @default(0) @map("created_count")
  updatedCount   Int             @default(0) @map("updated_count")
  unchangedCount Int             @default(0) @map("unchanged_count")
  closedCount    Int             @default(0) @map("closed_count")
  skippedCount   Int             @default(0) @map("skipped_count")
  duplicateCount Int             @default(0) @map("duplicate_count")
  /// Message d'erreur nettoyé (jamais de secret ni de donnée personnelle).
  error          String?         @db.Text

  @@index([startedAt])
  @@index([sourceKey, startedAt])
  @@map("source_runs")
}

// ---------------------------------------------------------------------------
// Matching : garde-fous (filtres durs) puis score expliqué (`src/lib/matching`)
// ---------------------------------------------------------------------------

enum MatchStatus {
  NEW
  SEEN
  SAVED
  DISMISSED
}

enum AlertFrequency {
  OFF
  DAILY
  WEEKLY
}

/// Offre qualifiée pour un candidat : elle respecte TOUS ses garde-fous au
/// moment du calcul (et la page les revérifie à l'affichage). Calculé par le
/// worker, jamais au chargement d'une page.
model Match {
  id          String      @id @default(cuid())
  userId      String      @map("user_id")
  offerId     String      @map("offer_id")
  /// Score de 0 à 100.
  score       Int
  /// Explication lisible (`src/lib/matching/explanation.ts`), dans la langue du candidat.
  explanation Json
  /// Empreinte des éléments du calcul : explication régénérée seulement s'ils changent.
  inputHash   String      @map("input_hash")
  status      MatchStatus @default(NEW)
  computedAt  DateTime    @map("computed_at")
  /// Date d'envoi dans un résumé d'alertes (`null` = jamais envoyé).
  notifiedAt  DateTime?   @map("notified_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  user  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer JobOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([userId, offerId])
  @@index([userId, score])
  @@index([offerId])
  @@map("matches")
}

/// État du matching d'un candidat (1-1) et préférences d'alertes e-mail.
model MatchingState {
  userId         String         @id @map("user_id")
  /// Recalcul demandé (mémoire, garde-fous ou nouvelles offres) ; le worker
  /// attend quelques secondes sans nouveau changement avant de recalculer.
  dirtyAt        DateTime?      @map("dirty_at")
  computedAt     DateTime?      @map("computed_at")
  alertFrequency AlertFrequency @default(OFF) @map("alert_frequency")
  /// Score minimal des opportunités envoyées par e-mail.
  alertMinScore  Int            @default(70) @map("alert_min_score")
  alertSentAt    DateTime?      @map("alert_sent_at")
  /// Jeton aléatoire du lien de désabonnement (créé au premier envoi).
  alertToken     String?        @unique @map("alert_token")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([dirtyAt])
  @@map("matching_states")
}

/// Embedding (pgvector) du texte d'une offre. Donnée publique, sans lien avec un utilisateur.
model OfferEmbedding {
  offerId   String                @id @map("offer_id")
  model     String
  /// Empreinte du texte embarqué : un texte modifié est ré-embarqué.
  textHash  String                @map("text_hash")
  embedding Unsupported("vector")
  createdAt DateTime              @default(now()) @map("created_at")

  offer JobOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@map("offer_embeddings")
}

/// Embedding (pgvector) d'un élément de la mémoire de carrière, identifié par
/// l'empreinte de son texte (le texte lui-même n'est pas stocké ici).
model MemoryEmbedding {
  userId    String                @map("user_id")
  model     String
  textHash  String                @map("text_hash")
  embedding Unsupported("vector")
  createdAt DateTime              @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, model, textHash])
  @@map("memory_embeddings")
}

// ---------------------------------------------------------------------------
// Stealth Proxy : carte de profil anonyme et prise de contact par l'agent
// (`src/lib/card`, `src/lib/contact`). Tout est rattaché au candidat et filtré
// par `userId` ; les liens publics passent par un jeton aléatoire dont seule
// l'empreinte est stockée.
// ---------------------------------------------------------------------------

/// Carte de profil anonyme (1-1), générée depuis la mémoire PSEUDONYMISÉE
/// (jamais depuis le coffre) puis relue et modifiée par le candidat.
/// `content` : contenu validé par zod (`src/lib/card/schema.ts`).
model ProfileCard {
  userId     String    @id @map("user_id")
  content    Json
  /// Validation par le candidat (contrôle de ré-identification réussi). Toute
  /// modification la remet à `null` : la carte n'est plus partageable.
  approvedAt DateTime? @map("approved_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profile_cards")
}

/// Lien public vers la carte (`/p/<jeton>`) : imprévisible, expirant, révocable.
/// Seule l'empreinte SHA-256 du jeton est stockée.
model CardLink {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  viewCount    Int       @default(0) @map("view_count")
  lastViewedAt DateTime? @map("last_viewed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact            Contact?
  /// Lien joint à un message de négociation (page de réponse comprise).
  negotiationMessage NegotiationMessage?

  @@index([userId])
  @@map("card_links")
}

enum ContactChannel {
  /// Envoyé par l'application à l'adresse de candidature de l'offre.
  EMAIL
  /// Offre sans adresse : le candidat colle lui-même le message sur la page « Postuler ».
  APPLY_URL
}

enum ContactStatus {
  /// Brouillon de l'agent, modifiable.
  DRAFT
  /// Approuvé explicitement par le candidat : seul état envoyable.
  APPROVED
  /// Envoi en cours (réservation contre le double envoi).
  SENDING
  /// Envoyé (e-mail) ou marqué comme transmis par le candidat (URL).
  SENT
}

/// Prise de contact avec une entreprise pour une offre (une seule par offre).
/// Les textes sont chiffrés (AAD `user:<id>:contact`) ; l'adresse de
/// destination n'est pas copiée ici : elle reste celle publiée dans l'offre.
model Contact {
  id           String         @id @default(cuid())
  userId       String         @map("user_id")
  offerId      String         @map("offer_id")
  channel      ContactChannel
  status       ContactStatus  @default(DRAFT)
  /// Langue de l'offre : celle du message.
  locale       String
  subjectEnc   String         @map("subject_enc")
  bodyEnc      String         @map("body_enc")
  /// Le brouillon vient du LLM (`llm`) ou du modèle déterministe (`rules`).
  draftSource  String         @map("draft_source")
  /// Empreinte du texte approuvé : un texte modifié après approbation n'est plus envoyable.
  approvedHash String?        @map("approved_hash")
  approvedAt   DateTime?      @map("approved_at")
  /// Message final tel qu'envoyé (ou à coller), liens compris, chiffré.
  sentTextEnc  String?        @map("sent_text_enc")
  sentAt       DateTime?      @map("sent_at")
  /// Lien de carte créé pour ce contact (page de réponse comprise).
  cardLinkId   String?        @unique @map("card_link_id")
  /// Dernier échec d'envoi (code, sans détail).
  lastError    String?        @map("last_error")
  /// Fil passé d'anonyme à révélé : date de la dernière levée d'anonymat
  /// (le fait reste acquis après révocation : l'entreprise a pu voir l'identité).
  revealedAt   DateTime?      @map("revealed_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer          JobOffer        @relation(fields: [offerId], references: [id], onDelete: Cascade)
  cardLink       CardLink?       @relation(fields: [cardLinkId], references: [id], onDelete: SetNull)
  replies        ContactReply[]
  handovers      Handover[]
  handoverEvents HandoverEvent[]

  negotiationMandate  NegotiationMandate?
  negotiationMessages NegotiationMessage[]

  @@unique([userId, offerId])
  /// Quota quotidien : envois récents du candidat.
  @@index([userId, sentAt])
  @@map("contacts")
}

/// Réponse d'une entreprise, déposée sur la page de réponse liée au jeton.
/// Texte chiffré (AAD `user:<id>:contact-reply`) : il peut nommer le recruteur.
model ContactReply {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  contactId String    @map("contact_id")
  bodyEnc   String    @map("body_enc")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([contactId, createdAt])
  @@map("contact_replies")
}

/// Levée d'anonymat (handover) : le candidat révèle les champs de son identité
/// qu'il a choisis à UNE entreprise (un contact), via un lien à jeton
/// (empreinte seule stockée), expirant et révocable.
///
/// Les champs révélés sont déchiffrés du coffre DANS LE NAVIGATEUR et envoyés
/// au serveur seulement à la confirmation ; ils sont alors chiffrés avec la
/// clé de la plateforme (AAD `handover:<userId>:<id>`). À la révocation ou à
/// l'expiration, `payloadEnc` et `cvEnc` sont effacés : la ligne ne garde que
/// des métadonnées (noms des champs, dates) pour le journal du candidat.
model Handover {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  contactId    String    @map("contact_id")
  tokenHash    String    @unique @map("token_hash")
  /// Noms des champs révélés (`name`, `email`, `cv`…), jamais leurs valeurs.
  fields       String[]
  /// Identité révélée (JSON chiffré), `null` une fois purgée.
  payloadEnc   String?   @map("payload_enc")
  /// CV d'origine (chiffré, nom et type compris), `null` s'il n'est pas révélé ou une fois purgé.
  cvEnc        Bytes?    @map("cv_enc")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  /// Données révélées effacées (révocation ou expiration).
  purgedAt     DateTime? @map("purged_at")
  viewCount    Int       @default(0) @map("view_count")
  lastViewedAt DateTime? @map("last_viewed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  events  HandoverEvent[]

  @@index([userId, contactId])
  /// Purge du worker : levées expirées non encore effacées.
  @@index([purgedAt, expiresAt])
  @@map("handovers")
}

enum HandoverEventType {
  REVEALED
  REVOKED
  EXPIRED
}

/// Journal des levées d'anonymat, visible par le candidat : quoi (noms des
/// champs), quand, pour quel fil. Aucune valeur d'identité.
model HandoverEvent {
  id         String            @id @default(cuid())
  userId     String            @map("user_id")
  contactId  String            @map("contact_id")
  handoverId String?           @map("handover_id")
  type       HandoverEventType
  fields     String[]
  createdAt  DateTime          @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact  Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  handover Handover? @relation(fields: [handoverId], references: [id], onDelete: SetNull)

  @@index([userId, contactId, createdAt])
  @@map("handover_events")
}

enum NegotiationStatus {
  /// Négociation en cours : l'agent peut rédiger des contre-propositions.
  ACTIVE
  /// Mise en pause par le candidat.
  PAUSED
  /// Le candidat a décidé d'accepter (jamais l'agent à sa place).
  ACCEPTED
  /// Le candidat a décidé de décliner.
  DECLINED
}

enum NegotiationDirection {
  /// Message du candidat (rédigé par l'agent, approuvé par le candidat).
  OUT
  /// Réponse de l'entreprise (page de réponse à jeton).
  IN
}

/// Mandat de négociation donné par le candidat à son agent, pour un contact :
/// plancher, cible, points non négociables et souhaitables. Contenu chiffré
/// (JSON, AAD `user:<id>:negotiation`) ; seuls le statut et les dates sont en clair.
model NegotiationMandate {
  id         String            @id @default(cuid())
  userId     String            @map("user_id")
  contactId  String            @unique @map("contact_id")
  contentEnc String            @map("content_enc")
  status     NegotiationStatus @default(ACTIVE)
  /// Date de la décision (acceptée, déclinée) ; `null` en cours ou en pause.
  closedAt   DateTime?         @map("closed_at")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("negotiation_mandates")
}

/// Fil de négociation d'un contact. Sortant : même cycle que `Contact`
/// (BROUILLON → APPROUVÉ, lié au texte exact par `approvedHash` → ENVOYÉ).
/// Entrant : réponse de l'entreprise, reçue `SENT`. Corps chiffré (AAD
/// `user:<id>:negotiation`).
model NegotiationMessage {
  id           String               @id @default(cuid())
  userId       String               @map("user_id")
  contactId    String               @map("contact_id")
  direction    NegotiationDirection
  /// `counter` (contre-proposition), `closing` (message de clôture) ou `reply` (entrant).
  kind         String
  status       ContactStatus        @default(DRAFT)
  bodyEnc      String               @map("body_enc")
  /// Brouillon du LLM (`llm`) ou du modèle déterministe (`rules`) ; `null` pour un entrant.
  draftSource  String?              @map("draft_source")
  approvedHash String?              @map("approved_hash")
  approvedAt   DateTime?            @map("approved_at")
  /// Message final tel qu'envoyé (ou à coller), mentions comprises, chiffré.
  sentTextEnc  String?              @map("sent_text_enc")
  sentAt       DateTime?            @map("sent_at")
  /// Lecture par le candidat (entrants).
  readAt       DateTime?            @map("read_at")
  cardLinkId   String?              @unique @map("card_link_id")
  lastError    String?              @map("last_error")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact  Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  cardLink CardLink? @relation(fields: [cardLinkId], references: [id], onDelete: SetNull)

  @@index([contactId, createdAt])
  /// Quota quotidien commun avec les prises de contact.
  @@index([userId, sentAt])
  @@map("negotiation_messages")
}

// ---------------------------------------------------------------------------
// Espace entreprise (phase 2) : les entreprises publient leurs offres, payées à
// l'unité. Règle produit : une entreprise ne voit, ne recherche et ne reçoit
// JAMAIS de classement de candidats ; aucune donnée candidat n'est rattachée à
// ces modèles. Les offres publiées rejoignent `job_offers` (`source = "direct"`)
// et passent par le matching comme celles des autres sources.
// ---------------------------------------------------------------------------

enum OrganizationStatus {
  /// En attente de vérification (domaine non concordant ou webmail) : aucune publication.
  PENDING
  ACTIVE
  /// Suspendue par un administrateur : ses offres sont fermées.
  SUSPENDED
}

enum OrganizationRole {
  OWNER
  MEMBER
}

/// Entreprise inscrite sur l'espace entreprise. Données de l'entreprise,
/// pas d'une personne : seuls les membres (`OrganizationMember`) relient un compte.
model Organization {
  id              String             @id @default(cuid())
  name            String
  /// Site web déclaré (https://…), et son domaine normalisé (sans `www.`).
  website         String
  domain          String
  /// Code de secteur (`src/lib/career/codes.ts`).
  sector          String
  size            CompanySize
  /// Code pays ISO 3166-1 alpha-2.
  country         String
  /// Domaine de l'e-mail du membre fondateur vérifié contre celui du site, ou
  /// validation par un administrateur.
  verifiedAt      DateTime?          @map("verified_at")
  status          OrganizationStatus @default(PENDING)
  /// Motif du dernier refus ou de la suspension (saisi par l'administrateur).
  reviewNote      String?            @map("review_note")
  /// Fiche `companies` sous laquelle les offres sont publiées.
  companyId       String             @unique @map("company_id")
  /// Version des conditions entreprises acceptées à l'inscription, et sa date
  /// (`null` pour les organisations créées avant ces conditions).
  termsVersion    String?            @map("terms_version")
  termsAcceptedAt DateTime?          @map("terms_accepted_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  company  Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  members  OrganizationMember[]
  postings JobPosting[]
  payments JobPostingPayment[]

  @@index([status])
  @@index([domain])
  @@map("organizations")
}

model OrganizationMember {
  id        String           @id @default(cuid())
  orgId     String           @map("org_id")
  userId    String           @map("user_id")
  role      OrganizationRole @default(MEMBER)
  createdAt DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@map("organization_members")
}

/// Cycle de vie d'une offre directe (`src/lib/employer/lifecycle.ts`).
enum JobPostingStatus {
  DRAFT
  AWAITING_PAYMENT
  IN_REVIEW
  LIVE
  CLOSED
  REJECTED
}

/// Publication d'une offre par une organisation. Le contenu vit dans
/// `job_offers` (statut `DRAFT` tant que l'offre n'est pas en ligne) ; ici,
/// l'état de publication : paiement, modération, expiration.
/// En ligne seulement si payée ET approuvée ET organisation active.
model JobPosting {
  id          String           @id @default(cuid())
  orgId       String           @map("org_id")
  offerId     String           @unique @map("offer_id")
  status      JobPostingStatus @default(DRAFT)
  /// Paiement de la période en cours (ou publication gratuite d'un administrateur).
  paidAt      DateTime?        @map("paid_at")
  /// Modération passée (automatique si rien n'est signalé, sinon par un administrateur).
  approvedAt  DateTime?        @map("approved_at")
  /// Catégories de critères potentiellement discriminatoires repérées (âge, sexe…).
  flags       String[]
  /// Motif du dernier refus (envoyé à l'entreprise).
  reviewNote  String?          @map("review_note")
  publishedAt DateTime?        @map("published_at")
  expiresAt   DateTime?        @map("expires_at")
  closedAt    DateTime?        @map("closed_at")
  /// Nombre de candidats ayant ouvert l'offre parmi leurs opportunités (aucune identité).
  viewCount   Int              @default(0) @map("view_count")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  offer        JobOffer            @relation(fields: [offerId], references: [id], onDelete: Cascade)
  payments     JobPostingPayment[]

  @@index([orgId, status])
  @@index([status, expiresAt])
  @@map("job_postings")
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELED
}

/// Achat unitaire d'une publication (ou d'un renouvellement) de 30 jours,
/// via le fournisseur de paiement (Stripe Checkout `mode=payment`, ou son
/// simulateur). Aucune donnée bancaire : montant, devise, identifiants.
model JobPostingPayment {
  id                String        @id @default(cuid())
  postingId         String        @map("posting_id")
  orgId             String        @map("org_id")
  /// Membre qui a lancé le paiement.
  userId            String?       @map("user_id")
  /// `simulator`, `stripe` ou `admin` (publication offerte par un administrateur).
  provider          String
  /// Session de paiement (`cs_…` chez Stripe, `sim_cs_…` dans le simulateur).
  checkoutSessionId String?       @unique @map("checkout_session_id")
  amountCents       Int           @map("amount_cents")
  currency          String
  status            PaymentStatus @default(PENDING)
  paidAt            DateTime?     @map("paid_at")
  createdAt         DateTime      @default(now()) @map("created_at")

  posting      JobPosting   @relation(fields: [postingId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([postingId, status])
  @@index([userId])
  @@map("job_posting_payments")
}
