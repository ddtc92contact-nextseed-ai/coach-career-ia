# Copier en `.env` puis compléter. Ne jamais versionner `.env`.

# --- Base de données ------------------------------------------------------
# Dev local : `npm run db:up` démarre PostgreSQL + pgvector sur 127.0.0.1:${POSTGRES_PORT}.
POSTGRES_PORT=5433
DATABASE_URL=postgresql://coach:coach@127.0.0.1:5433/coach_career
# Base dédiée aux tests d'intégration (créée par docker-compose.dev.yml).
# Laisser vide pour n'exécuter que les tests unitaires.
TEST_DATABASE_URL=postgresql://coach:coach@127.0.0.1:5433/coach_career_test

# Production (docker-compose.yml) : identifiants du conteneur postgres.
POSTGRES_USER=coach
POSTGRES_PASSWORD=
POSTGRES_DB=coach_career

# --- Authentification (Auth.js) -------------------------------------------
# Secret de signature, 32 caractères minimum : `openssl rand -base64 32`
AUTH_SECRET=
# URL publique de l'application (en production : https://<SITE_DOMAIN>).
AUTH_URL=http://localhost:3000

# --- E-mail (lien magique) ------------------------------------------------
# Sans SMTP_HOST en développement, le lien est affiché dans la console du serveur.
# En production, SMTP_HOST est obligatoire.
EMAIL_FROM="Coach Career IA <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true = TLS implicite (port 465) ; false = STARTTLS si proposé (port 587).
SMTP_SECURE=false

# --- Chiffrement applicatif des champs sensibles --------------------------
# Clé AES-256 : 32 octets en base64, `openssl rand -base64 32`
DATA_ENCRYPTION_KEY=
# Version de la clé courante (incrémenter à chaque rotation).
DATA_ENCRYPTION_KEY_VERSION=1
# Anciennes clés conservées pour relire les données : `1:<base64>,2:<base64>`
DATA_ENCRYPTION_PREVIOUS_KEYS=

# --- Pièces justificatives ------------------------------------------------
# Dossier privé des documents envoyés (chiffrés). Défaut : ./storage/uploads.
# En production (docker-compose.yml) : volume `uploads` monté sur /app/storage/uploads.
UPLOAD_DIR=

# --- Administration --------------------------------------------------------
# Adresses autorisées sur les pages d'administration (/app/radar), séparées par des virgules.
ADMIN_EMAILS=

# --- Market Radar (collecte d'offres) -------------------------------------
# Contact affiché dans le User-Agent du radar (URL ou mailto:), OBLIGATOIRE pour collecter :
#   CoachCareerIA-Radar/1.0 (+https://exemple.fr/contact)
RADAR_CONTACT=
# Périodicité du worker (heures) et passage immédiat au démarrage.
RADAR_INTERVAL_HOURS=6
RADAR_RUN_ON_START=true
# Pays conservés (ISO-2, virgules), « * » pour tous. Les offres sans pays connu sont gardées.
RADAR_COUNTRIES=FR
# Liste des entreprises suivies via leur job board ATS public (Greenhouse, Lever, Ashby).
RADAR_COMPANIES_FILE=config/radar-companies.json
# Intervalle minimal entre deux requêtes vers un même hôte (ms, ≥ 250).
RADAR_MIN_INTERVAL_MS=1000
# API France Travail « Offres d'emploi v2 » (compte partenaire sur francetravail.io).
# Sans identifiants, la source France Travail est simplement ignorée.
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
# Critères de recherche : codes ROME, mots-clés, départements (virgules).
RADAR_FT_ROME_CODES=M1805,M1806,M1802
RADAR_FT_KEYWORDS=
RADAR_FT_DEPARTMENTS=75,92,93,94,69
# Plafond d'offres par recherche (l'API en sert 3150 au maximum).
RADAR_FT_MAX_RESULTS=1050

# --- Géocodage (filtre de distance) ---------------------------------------
# Base Adresse Nationale (France) puis Nominatim/OpenStreetMap (autres pays) : publics, sans clé.
# User-Agent : CoachCareerIA-Geo/1.0 (+RADAR_CONTACT, sinon AUTH_URL) ; sans contact, désactivé.
GEO_ENABLED=true
# Géoplateforme IGN (remplace api-adresse.data.gouv.fr, décommissionnée).
GEO_BAN_URL=https://data.geopf.fr/geocodage/search
# Nominatim : 1 requête/s max, résultats en cache ; plafond de requêtes par passage du radar.
GEO_NOMINATIM_ENABLED=true
GEO_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
GEO_NOMINATIM_MAX_PER_RUN=200
GEO_TIMEOUT_MS=5000

# --- IA (import du parcours, futur coach) ----------------------------------
# Fournisseur : mistral (défaut), openai-compatible (ex. Ollama local) ou mock.
# Les clés restent côté serveur (jamais dans le bundle client). Sous Vitest, le
# simulateur est toujours utilisé.
AI_PROVIDER=mistral
# API Mistral (hébergement UE) : https://console.mistral.ai
MISTRAL_API_KEY=
# Facultatifs : modèle de chat (mistral-small-latest), d'embeddings (mistral-embed), URL.
MISTRAL_CHAT_MODEL=
MISTRAL_EMBED_MODEL=
MISTRAL_BASE_URL=
# Endpoint compatible OpenAI, par ex. Ollama : http://127.0.0.1:11434/v1
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_CHAT_MODEL=
OPENAI_COMPAT_EMBED_MODEL=
# Délai par tentative (ms) et nombre de reprises après une erreur passagère.
AI_TIMEOUT_MS=45000
AI_MAX_RETRIES=2
# Coach IA : messages par utilisateur sur 24 h glissantes (0 = coach désactivé).
COACH_MESSAGES_PER_DAY=40
# Jeton GitHub facultatif (lecture publique seule) : relève la limite de 60 requêtes/heure de l'import GitHub.
GITHUB_TOKEN=

# --- Matching (opportunités) et alertes ------------------------------------
# Recalcul par le worker après chaque changement (mémoire, garde-fous, offres).
MATCHING_ENABLED=true
# Intervalle du worker et délai sans nouveau changement avant recalcul (secondes).
MATCHING_POLL_SECONDS=60
MATCHING_DEBOUNCE_SECONDS=30
# Score minimal (0-100) d'une opportunité conservée, et plafond par candidat.
MATCHING_MIN_SCORE=40
MATCHING_MAX_PER_USER=200
# Résumés d'explication formulés par le LLM (repli déterministe sinon), plafond d'appels par passage.
MATCHING_LLM_EXPLANATIONS=true
MATCHING_LLM_MAX_PER_RUN=30
MATCHING_LLM_MIN_SCORE=55
# Bornes de similarité cosinus des embeddings (mistral-embed : 0.55 / 0.85).
MATCHING_SIM_FLOOR=0.55
MATCHING_SIM_CEIL=0.85
# URL publique des liens des e-mails d'alerte (défaut : AUTH_URL).
APP_URL=

# --- Logs -----------------------------------------------------------------
# debug | info | warn | error (défaut : info en production, debug sinon)
LOG_LEVEL=

# --- Coffre d'identité ------------------------------------------------------
# Verrouillage automatique après N minutes d'inactivité (défaut 15, lu au build).
NEXT_PUBLIC_VAULT_IDLE_MINUTES=

# --- Déploiement derrière Traefik (docker-compose.yml) ---------------------
SITE_DOMAIN=coach.example.com
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
APP_MEM_LIMIT=768m
WORKER_MEM_LIMIT=384m
POSTGRES_MEM_LIMIT=512m
