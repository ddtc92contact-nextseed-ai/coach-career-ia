# Copier en `.env` puis compléter. Ne jamais versionner `.env`.

# --- Base de données ------------------------------------------------------
# Dev local : `npm run db:up` démarre PostgreSQL + pgvector sur 127.0.0.1:${POSTGRES_PORT}.
POSTGRES_PORT=5433
DATABASE_URL=postgresql://coach:coach@127.0.0.1:5433/coach_career
# Base dédiée aux tests d'intégration (créée par docker-compose.dev.yml).
# Laisser vide pour n'exécuter que les tests unitaires.
TEST_DATABASE_URL=postgresql://coach:coach@127.0.0.1:5433/coach_career_test

# Production (docker-compose.yml) : identifiants du conteneur postgres.
POSTGRES_USER=coach
POSTGRES_PASSWORD=
POSTGRES_DB=coach_career

# --- Authentification (Auth.js) -------------------------------------------
# Secret de signature, 32 caractères minimum : `openssl rand -base64 32`
AUTH_SECRET=
# URL publique de l'application (en production : https://<SITE_DOMAIN>).
AUTH_URL=http://localhost:3000

# --- E-mail (lien magique) ------------------------------------------------
# Sans SMTP_HOST en développement, le lien est affiché dans la console du serveur.
# En production, SMTP_HOST est obligatoire.
EMAIL_FROM="Coach Career IA <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true = TLS implicite (port 465) ; false = STARTTLS si proposé (port 587).
SMTP_SECURE=false

# --- Chiffrement applicatif des champs sensibles --------------------------
# Clé AES-256 : 32 octets en base64, `openssl rand -base64 32`
DATA_ENCRYPTION_KEY=
# Version de la clé courante (incrémenter à chaque rotation).
DATA_ENCRYPTION_KEY_VERSION=1
# Anciennes clés conservées pour relire les données : `1:<base64>,2:<base64>`
DATA_ENCRYPTION_PREVIOUS_KEYS=

# --- Pièces justificatives ------------------------------------------------
# Dossier privé des documents envoyés (chiffrés). Défaut : ./storage/uploads.
# En production (docker-compose.yml) : volume `uploads` monté sur /app/storage/uploads.
UPLOAD_DIR=

# --- Logs -----------------------------------------------------------------
# debug | info | warn | error (défaut : info en production, debug sinon)
LOG_LEVEL=

# --- Déploiement derrière Traefik (docker-compose.yml) ---------------------
SITE_DOMAIN=coach.example.com
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
APP_MEM_LIMIT=768m
WORKER_MEM_LIMIT=256m
POSTGRES_MEM_LIMIT=512m
